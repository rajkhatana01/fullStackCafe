<!-- Hero Section with Gradient -->
<div class="relative bg-gradient-to-r from-indigo-600 to-purple-600 rounded-3xl p-10 mb-10 text-center text-white shadow-xl overflow-hidden">
  <div class="relative z-10">
    <h1 class="text-5xl font-extrabold mb-4 tracking-tight">FullStack Cafe Menu</h1>
    <% if (typeof user !== 'undefined' && user) { %>
      <p class="text-lg text-indigo-100">Welcome back, <span class="font-bold text-white"><%= user.name %></span>! Ready for something delicious?</p>
    <% } else { %>
      <p class="text-lg text-indigo-100">Fresh ingredients, made with love. <a href="/login" class="underline hover:text-white font-bold">Login to order</a>.</p>
    <% } %>
  </div>
  <!-- Decorative circles -->
  <div class="absolute top-0 left-0 w-64 h-64 bg-white opacity-10 rounded-full -translate-x-1/2 -translate-y-1/2"></div>
  <div class="absolute bottom-0 right-0 w-40 h-40 bg-white opacity-10 rounded-full translate-x-1/3 translate-y-1/3"></div>
</div>

<% 
  const categories = ["Breakfast", "Lunch", "Dinner", "Fast Food", "Desserts", "Drinks"];
  const allProducts = typeof products !== 'undefined' ? products : [];
%>

<!-- Category Navigation Pills -->
<div class="flex flex-wrap justify-center gap-3 mb-12 sticky top-4 z-20 bg-gray-50/95 py-2 backdrop-blur-sm">
  <% categories.forEach(cat => { %>
    <a href="#<%= cat.replace(/\s+/g, '-').toLowerCase() %>" 
       class="px-5 py-2 bg-white text-gray-700 rounded-full shadow-sm border border-gray-200 hover:bg-indigo-50 hover:text-indigo-600 hover:border-indigo-200 transition-all text-sm font-semibold no-underline">
      <%= cat %>
    </a>
  <% }) %>
</div>

<!-- Menu Sections -->
<div class="space-y-16">
  <% categories.forEach(category => { %>
    <% 
       const categoryProducts = allProducts.filter(p => p.category && p.category.toLowerCase() === category.toLowerCase()); 
       const sectionId = category.replace(/\s+/g, '-').toLowerCase();
    %>

    <% if (categoryProducts.length > 0) { %>
      <div id="<%= sectionId %>" class="scroll-mt-24">
        <div class="flex items-center mb-8">
          <h2 class="text-3xl font-bold text-gray-800 mr-4"><%= category %></h2>
          <div class="h-1 flex-grow bg-gray-200 rounded-full"></div>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
          <% categoryProducts.forEach(product => { %>
            <div class="group bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100 flex flex-col h-full transform hover:-translate-y-1">
              
              <!-- Image Container -->
              <div class="relative h-56 overflow-hidden">
                <img src="<%= product.image || 'https://placehold.co/400x300?text=No+Image' %>" 
                     alt="<%= product.name %>" 
                     class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
                <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full shadow-sm">
                  <span class="text-indigo-700 font-bold text-sm">₹<%= product.price %></span>
                </div>
              </div>

              <div class="p-5 flex flex-col flex-grow">
                <h3 class="font-bold text-gray-800 text-xl mb-2 group-hover:text-indigo-600 transition-colors"><%= product.name %></h3>
                
                <p class="text-gray-500 text-sm mb-6 flex-grow leading-relaxed line-clamp-3">
                  <%= product.description %>
                </p>

                <% if (typeof user !== 'undefined' && user) { %>
                  <button onclick="addToCart('<%= product._id %>', '<%= product.name %>', <%= product.price %>, '<%= product.image %>')" 
                          class="w-full bg-gray-900 text-white py-3 rounded-xl text-sm font-semibold hover:bg-indigo-600 active:scale-95 transition-all shadow-lg shadow-gray-200 hover:shadow-indigo-200 flex items-center justify-center gap-2">
                    <i data-lucide="shopping-bag" class="w-5 h-5"></i>
                    Add to Order
                  </button>
                <% } else { %>
                   <a href="/login" class="block text-center w-full border border-gray-200 text-gray-600 py-2 rounded-xl text-sm font-medium hover:bg-gray-50 transition">
                    Login to Add
                  </a>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>
  <% }) %>
</div>

<script>
  function addToCart(id, name, price, image) {
    let cart = JSON.parse(localStorage.getItem('cafeCart')) || [];
    
    const existingItem = cart.find(item => item.productId === id);
    if (existingItem) {
      existingItem.quantity += 1;
    } else {
      cart.push({ productId: id, name, price, image, quantity: 1 });
    }

    localStorage.setItem('cafeCart', JSON.stringify(cart));
    
    // Update Navbar Count
    const count = cart.reduce((acc, item) => acc + item.quantity, 0);
    document.getElementById('cart-count').innerText = count;

    // Simple feedback
    alert(name + " added to cart!");
  }
</script>