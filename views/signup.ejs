<div class="flex justify-center">
  <div class="bg-white p-8 rounded-2xl shadow-md w-96">
    <h2 class="text-2xl font-bold mb-6 text-center text-indigo-600">Signup</h2>

    <form method="POST" action="/signup" enctype="multipart/form-data" class="space-y-4">
      
      <input name="name" placeholder="Name"
        class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-400" required />

      <input name="email" placeholder="Email"
        class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-400" required />

      <input name="password" type="password" placeholder="Password"
        class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-400" required />

      <!-- ✅ Profile Photo -->
      <input type="file" name="profilePic" accept="image/*"
        class="w-full border rounded-lg px-3 py-2" required />

      <button
        class="w-full bg-indigo-600 text-white py-2 rounded-lg hover:bg-indigo-700 transition">
        Create Account
      </button>
    </form>

    <p class="text-sm text-center mt-4">
      Already have an account?
      <a href="/login" class="text-indigo-600 font-semibold">Login</a>
    </p>
  </div>
</div>