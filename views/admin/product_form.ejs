<div class="max-w-2xl mx-auto bg-white rounded-xl shadow-md overflow-hidden p-8">
  <h2 class="text-2xl font-bold text-gray-800 mb-6"><%= title %></h2>

  <form action="/admin/product/save<%= product ? '/' + product._id : '' %>" method="POST" enctype="multipart/form-data" class="space-y-6">
    
    <!-- Name -->
    <div>
      <label for="name" class="block text-sm font-medium text-gray-700">Product Name</label>
      <input type="text" name="name" id="name" value="<%= product ? product.name : '' %>" required
             class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border">
    </div>

    <!-- Price -->
    <div>
      <label for="price" class="block text-sm font-medium text-gray-700">Price (₹)</label>
      <input type="number" name="price" id="price" value="<%= product ? product.price : '' %>" required
             class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border">
    </div>

    <!-- Category -->
    <div>
      <label for="category" class="block text-sm font-medium text-gray-700">Category</label>
      <select name="category" id="category" required
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border">
        <% const categories = ["Breakfast", "Lunch", "Dinner", "Fast Food", "Desserts", "Drinks"]; %>
        <% categories.forEach(cat => { %>
          <option value="<%= cat %>" <%= product && product.category === cat ? 'selected' : '' %>><%= cat %></option>
        <% }) %>
      </select>
    </div>

    <!-- Description -->
    <div>
      <label for="description" class="block text-sm font-medium text-gray-700">Description</label>
      <textarea name="description" id="description" rows="3" required
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border"><%= product ? product.description : '' %></textarea>
    </div>

    <!-- Image -->
    <div>
      <label class="block text-sm font-medium text-gray-700">Product Image</label>
      <input type="file" name="image" class="mt-1 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100">
      <% if (product && product.image) { %>
        <input type="hidden" name="existingImage" value="<%= product.image %>">
        <p class="mt-2 text-xs text-gray-500">Current image: <a href="<%= product.image %>" target="_blank" class="text-indigo-600 hover:underline">View</a></p>
      <% } %>
    </div>

    <div class="flex justify-end space-x-3">
      <a href="/admin/dashboard" class="bg-gray-200 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-300 transition flex items-center gap-2">
        <i data-lucide="x" class="w-4 h-4"></i> Cancel
      </a>
      <button type="submit" class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 transition flex items-center gap-2">
        <i data-lucide="save" class="w-4 h-4"></i> Save Product
      </button>
    </div>
  </form>
</div>