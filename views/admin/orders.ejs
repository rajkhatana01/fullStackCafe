<div class="flex flex-col space-y-6">
    <div class="flex justify-between items-center">
        <h1 class="text-3xl font-bold text-gray-800">Live Kitchen Queue</h1>
        <span class="text-sm text-gray-500 flex items-center gap-2">
            <i data-lucide="clock" class="w-4 h-4"></i> Auto-refreshing every 30s
        </span>
    </div>
    
    <!-- Pending Orders Table -->
    <div class="bg-white shadow-md rounded-lg overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full text-left text-sm">
                <thead class="bg-gray-100 text-gray-600 uppercase font-medium">
                    <tr>
                        <th class="px-6 py-3">Order ID</th>
                        <th class="px-6 py-3">Items</th>
                        <th class="px-6 py-3">Pickup Time</th>
                        <th class="px-6 py-3">Current Status</th>
                        <th class="px-6 py-3">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    <% if (typeof orders !== 'undefined' && orders.length > 0) { %>
                        <% orders.forEach(order => { %>
                            <tr class="hover:bg-gray-50 transition">
                                <td class="px-6 py-4 font-medium">#<%= order._id.toString().slice(-6) %></td>
                                <td class="px-6 py-4">
                                    <ul class="list-disc list-inside text-gray-700">
                                        <% order.items.forEach(item => { %>
                                            <li><%= item.product ? item.product.name : 'Removed Item' %> <span class="font-bold">x<%= item.quantity %></span></li>
                                        <% }) %>
                                    </ul>
                                </td>
                                <td class="px-6 py-4 text-indigo-600 font-bold">
                                    <%= order.pickupTime ? new Date(order.pickupTime).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) : 'ASAP' %>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="px-3 py-1 rounded-full text-xs font-bold
                                        <%= order.status === 'Pending' ? 'bg-yellow-100 text-yellow-800' : '' %>
                                        <%= order.status === 'Preparing' ? 'bg-blue-100 text-blue-800' : '' %>
                                        <%= order.status === 'Ready' ? 'bg-green-100 text-green-800' : '' %>">
                                        <%= order.status %>
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <form action="/admin/order/update-status" method="POST">
                                        <input type="hidden" name="orderId" value="<%= order._id %>">
                                        <% if (order.status === 'Pending') { %>
                                            <button name="status" value="Preparing" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-xs font-bold uppercase tracking-wider transition">Start Cooking</button>
                                        <% } else if (order.status === 'Preparing') { %>
                                            <button name="status" value="Ready" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md text-xs font-bold uppercase tracking-wider transition">Mark Ready</button>
                                        <% } else if (order.status === 'Ready') { %>
                                            <button name="status" value="Completed" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-md text-xs font-bold uppercase tracking-wider transition">Complete</button>
                                        <% } %>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="5" class="px-6 py-8 text-center text-gray-500">No pending orders. Kitchen is clear!</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>setTimeout(() => window.location.reload(), 30000);</script>