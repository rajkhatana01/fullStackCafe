<div class="max-w-4xl mx-auto">
  <h1 class="text-3xl font-bold text-gray-800 mb-8">Your Cart</h1>

  <div id="empty-cart-msg" class="hidden text-center py-10">
    <p class="text-gray-500 text-lg mb-4">Your cart is empty.</p>
    <a href="/" class="text-indigo-600 font-semibold hover:underline">Browse Menu</a>
  </div>

  <div id="cart-content" class="hidden">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-6">
      <table class="w-full text-left">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="px-6 py-4 font-semibold text-gray-600">Product</th>
            <th class="px-6 py-4 font-semibold text-gray-600">Price</th>
            <th class="px-6 py-4 font-semibold text-gray-600">Quantity</th>
            <th class="px-6 py-4 font-semibold text-gray-600">Total</th>
            <th class="px-6 py-4 font-semibold text-gray-600">Action</th>
          </tr>
        </thead>
        <tbody id="cart-items-container" class="divide-y divide-gray-100">
          <!-- Items injected by JS -->
        </tbody>
      </table>
    </div>

    <div class="flex justify-end items-center gap-6">
      <div class="text-xl font-bold text-gray-800">
        Total: <span class="text-indigo-600">₹<span id="cart-total">0</span></span>
      </div>
      <button onclick="checkout()" class="bg-indigo-600 text-white px-8 py-3 rounded-xl font-bold hover:bg-indigo-700 transition shadow-lg shadow-indigo-200 flex items-center gap-2">
        <i data-lucide="check-circle" class="w-5 h-5"></i>
        Place Order
      </button>
    </div>
  </div>
</div>

<script>
  // Load Cart
  const cart = JSON.parse(localStorage.getItem('cafeCart')) || [];
  const container = document.getElementById('cart-items-container');
  const emptyMsg = document.getElementById('empty-cart-msg');
  const cartContent = document.getElementById('cart-content');

  function renderCart() {
    if (cart.length === 0) {
      emptyMsg.classList.remove('hidden');
      cartContent.classList.add('hidden');
      return;
    }

    emptyMsg.classList.add('hidden');
    cartContent.classList.remove('hidden');
    container.innerHTML = '';
    let total = 0;

    cart.forEach((item, index) => {
      const itemTotal = item.price * item.quantity;
      total += itemTotal;

      const row = `
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-4 font-medium text-gray-800">${item.name}</td>
          <td class="px-6 py-4 text-gray-600">₹${item.price}</td>
          <td class="px-6 py-4 text-gray-600">${item.quantity}</td>
          <td class="px-6 py-4 font-bold text-indigo-600">₹${itemTotal}</td>
          <td class="px-6 py-4">
            <button onclick="removeItem(${index})" class="text-red-500 hover:text-red-700 text-sm font-medium flex items-center gap-1"><i data-lucide="trash-2" class="w-4 h-4"></i> Remove</button>
          </td>
        </tr>
      `;
      container.innerHTML += row;
    });

    document.getElementById('cart-total').innerText = total;
    lucide.createIcons(); // Re-initialize icons for dynamic content
  }

  function removeItem(index) {
    cart.splice(index, 1);
    localStorage.setItem('cafeCart', JSON.stringify(cart));
    renderCart();
    // Update navbar count
    document.getElementById('cart-count').innerText = cart.reduce((acc, item) => acc + item.quantity, 0);
  }

  async function checkout() {
    const res = await fetch('/order/checkout', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ cartItems: cart })
    });
    const data = await res.json();
    if (data.success) {
      localStorage.removeItem('cafeCart');
      window.location.href = '/'; // Redirect to home or a success page
      alert("Order Placed Successfully!");
    } else {
      alert("Error: " + data.message);
    }
  }

  renderCart();
</script>