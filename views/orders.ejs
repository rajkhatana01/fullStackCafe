<div class="max-w-4xl mx-auto">
  <h1 class="text-3xl font-bold text-gray-800 mb-8">My Orders</h1>

  <% if (orders.length === 0) { %>
    <div class="text-center py-10">
      <p class="text-gray-500 text-lg mb-4">You haven't placed any orders yet.</p>
      <a href="/" class="text-indigo-600 font-semibold hover:underline">Browse Menu</a>
    </div>
  <% } else { %>
    <div class="space-y-6">
      <% orders.forEach(order => { %>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="bg-gray-50 px-6 py-4 border-b border-gray-200 flex justify-between items-center flex-wrap gap-2">
            <div>
              <span class="text-sm text-gray-500">Order ID:</span>
              <span class="font-mono text-gray-700 font-medium ml-1">#<%= order._id.toString().slice(-6) %></span>
              <span class="mx-2 text-gray-300">|</span>
              <span class="text-sm text-gray-500"><%= new Date(order.createdAt).toLocaleDateString() %></span>
            </div>
            <div>
              <% 
                let statusColor = 'bg-yellow-100 text-yellow-800';
                if (order.status === 'Completed') statusColor = 'bg-green-100 text-green-800';
                if (order.status === 'Cancelled') statusColor = 'bg-red-100 text-red-800';
                if (order.status === 'Preparing') statusColor = 'bg-blue-100 text-blue-800';
              %>
              <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide <%= statusColor %>">
                <%= order.status || 'Pending' %>
              </span>
            </div>
          </div>
          
          <div class="p-6">
            <ul class="divide-y divide-gray-100 mb-4">
              <% order.items.forEach(item => { %>
                <li class="py-2 flex justify-between items-center">
                  <div class="flex items-center gap-3">
                    <span class="text-gray-800 font-medium"><%= item.product ? item.product.name : 'Unknown Product' %></span>
                    <span class="text-gray-500 text-sm">x<%= item.quantity %></span>
                  </div>
                  <span class="text-gray-600">₹<%= item.price * item.quantity %></span>
                </li>
              <% }) %>
            </ul>
            
            <div class="flex justify-end items-center gap-4 border-t border-gray-100 pt-4">
              <% if (order.status === 'Pending') { %>
                <button onclick="cancelOrder('<%= order._id %>')" class="text-red-600 hover:text-red-800 text-sm font-bold border border-red-200 bg-red-50 px-4 py-2 rounded-lg transition hover:bg-red-100">
                  Cancel Order
                </button>
              <% } %>
              <div class="text-lg font-bold text-gray-800">
                Total: <span class="text-indigo-600">₹<%= order.totalAmount %></span>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<script>
  async function cancelOrder(orderId) {
    if(!confirm("Are you sure you want to cancel this order?")) return;

    try {
      const res = await fetch(`/orders/cancel/${orderId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        alert(data.message);
      }
    } catch (err) {
      console.error(err);
      alert("Error cancelling order");
    }
  }
</script>