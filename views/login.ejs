<div class="flex justify-center">
  <div class="bg-white p-8 rounded-2xl shadow-md w-96">
    <h2 class="text-2xl font-bold mb-6 text-center text-indigo-600">Login</h2>

    <form method="POST" action="/login" class="space-y-4">
      <div class="relative">
        <i data-lucide="mail" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 w-5 h-5"></i>
        <input name="email" placeholder="Email"
          class="w-full border rounded-lg pl-10 pr-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400" required />
      </div>

      <div class="relative">
        <i data-lucide="lock" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 w-5 h-5"></i>
        <input name="password" type="password" placeholder="Password"
          class="w-full border rounded-lg pl-10 pr-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400" required />
      </div>

      <button
        class="w-full bg-indigo-600 text-white py-2 rounded-lg hover:bg-indigo-700 transition">
        Login
      </button>
    </form>

    <p class="text-sm text-center mt-4">
      Don't have an account?
      <a href="/signup" class="text-indigo-600 font-semibold">Signup</a>
    </p>
  </div>
</div>
